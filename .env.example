# =============================================================================
# Openquire Environment Configuration
# =============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# =============================================================================
# Web Search Providers
# Openquire runs completely out of the box with DuckDuckGo (zero configuration required).
# No API keys, no self-hosting, and no search secrets are needed.
#
# Optional: If you ever want to connect a dedicated search provider in the future,
# the server supports reading these if set in environment variables:
#   BRAVE_API_KEY: Free 2,000 queries/month at https://brave.com/search/api
#   TAVILY_API_KEY: Free 1,000 queries/month at https://tavily.com
#   SEARXNG_URL: URL to a self-hosted SearXNG instance
#   DEFAULT_SEARCH_PROVIDER: 'duckduckgo' | 'brave' | 'tavily' | 'searxng' | 'wikipedia'
# =============================================================================

# =============================================================================
# Supabase Persistence & @supabase/server
# Provides remote PostgreSQL sync, JWT user verification, and row-level security.
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Client-facing variables for browser persistence & sync
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

